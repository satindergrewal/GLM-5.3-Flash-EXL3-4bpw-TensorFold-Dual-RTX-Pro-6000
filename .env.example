# Copy to .env (not in git) or export before ./serve/serve-tf.sh / ./build-image.sh.
# Everything here has a default; the model paths are required to serve.

# --- quant switch: pick which EXL3 checkpoint the lane serves -------------
QUANT=4bpw                # 4bpw (stock TR3-4bpw) | 3.5bpw (mixed k3/k4 encode)
MODEL_DIR_4BPW=           # e.g. /mnt/nvme2/brandonmusic-GLM-5.3-Flash-EXL3-4bpw
MODEL_DIR_35BPW=          # e.g. .../artifact-glm53-k35-mixed (146 GiB, abliterated mixed k3/k4)
# SERVED_NAME follows the switch: GLM-5.3-Flash-EXL3-4bpw / -3.5bpw-mixed
# (override with SERVED_NAME=... if your router expects a fixed id)

# --- ABLIT mode (TODO, disabled): abliterated-checkpoint lane -------------
# ABLIT=0 (default): serve the checkpoints above as-is.
# ABLIT=1: serve an abliterated variant per quant arm (checkpoint paths TBD —
# to be wired once an abliterated model is validated for this recipe).
ABLIT=0
#MODEL_DIR_ABLIT_4BPW=
#MODEL_DIR_ABLIT_35BPW=

# --- docker hub publish (publish-docker.sh) ----------------------------
DOCKER_USER=
#DOCKER_REPO=glm-5.3-flash-exl3-4bpw-tensorfold

# --- image build (build-image.sh) --------------------------------------
#TF_VERSION=v0.6.5-mixed-k34
#TF_REPO=https://github.com/satindergrewal/TensorFold.git
#BASE_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
#IMAGE=tensorfold-glm53:v0.6.0
#IMAGE_EXTRAS=av==18.1.0 xgrammar>=0.2.8,<0.3

# --- serve (serve/serve-tf.sh) -----------------------------------------
#PORT=8888
#MASTER_PORT=29551
#NAME=glm53-flash-tf-box
#PARALLEL=4              # concurrent decode streams (1-4, DFlash2 required for >1)
#CONTEXT=0               # 0 = largest native window that fits (1,048,576 here). The 3.5bpw
#                         # arm pins CONTEXT=1048576 in serve-tf.sh: its auto-fit stops one 64k
#                         # block short (983,040) while explicit context serves the full window.
#MAX_TOKENS=32768        # reply budget when the client sends none
#KV=fp8                  # fp8 = 1M window | bf16 = exact, ~196k window
#DENSE=q4                # q4 | fp8 | bf16 (checkpoint's BF16 dense weights repack)
#COMM=nccl               # nccl (PCIe, x86) | roce (Spark pairs)
#NCCL_LIB_DIR=           # dir holding a patched libnccl.so.2.* (e.g. ./nccl-matched from the
#                        # vLLM recipe image's /opt/local-inference/nccl/lib). When present,
#                        # serve-tf.sh LD_PRELOADs it + sets NCCL_P2P_LEVEL=4,
#                        # NCCL_PROTO=LL,LL128,Simple, NCCL_CUMEM_ENABLE=0 - worth ~5% prefill
#                        # (cold TTFT@166k 62.6-63.5 s -> 59.7-60.9 s). Empty = stock NCCL.
#TENSORFOLD_GLM_MAX_IMAGES=128
#TF_GLM_PREFILL_LANES=     # 2 = two prefill lanes (3.5bpw arm default; all published TTFT
#                          # numbers use it). 1 = single lane. 4bpw arm defaults to 1.
#TF_GLM_CACHE_GIB=0      # kept-prompt pool GiB; 0 = all memory to the 1M window
#TENSORFOLD_MEMORY_RESERVE_GIB=4
#RANK0_GPU=0
#RANK1_GPU=1
#SERVED_NAME=GLM-5.3-Flash-EXL3-4bpw
#TENSORFOLD_VISION_MAX_PIXELS=67108864    # decoded pixel ceiling per image (fork 3515684+; stock fork ignores, 16M default)
#TENSORFOLD_VISION_MAX_DIMENSION=16384     # max side in px (fork 3515684+; stock default 8192)
#TENSORFOLD_VISION_MAX_TOTAL_PIXELS=134217728  # per-request pixel budget (fork 3515684+; stock default 32M)
#TENSORFOLD_VISION_MAX_BYTES=52428800           # encoded bytes per image (fork 869bc2c+; stock default 10M)
#TENSORFOLD_VISION_MAX_TOTAL_BYTES=104857600    # encoded bytes per request (fork 869bc2c+; stock default 20M)
#TF_GLM_PAIR=1            # 1 (default): mixed-rate experts through the paired path (width-64 on the tuned
#                          # prompt kernels, width-48 universal; fork 098a5f5+). 0: the single universal path
#                          # (prefill ~10% slower, single-stream decode 163-175 tok/s instead of 130-158)
